# vim:ft=automake
# included from Top Level Makefile.am
# All paths should be given relative to the root

# Unit tests
check_PROGRAMS += tests/unit_tests
tests_unit_tests_SOURCES = \
    tests/unit_test.c \
    tests/test_framework.c \
    tests/test_mqtt_packet.c \
    tests/test_mqtt_client.c \
    src/mqtt_client.c \
    src/mqtt_packet.c \
    src/mqtt_socket.c \
    src/mqtt_sn_client.c \
    src/mqtt_sn_packet.c
tests_unit_tests_CPPFLAGS = -I$(top_srcdir) \
    -include $(top_srcdir)/tests/test_client_alloc.h $(AM_CPPFLAGS)
tests_unit_tests_LDADD = $(PTHREAD_LIBS)

# Property-lock lifecycle tests. Build mqtt_packet.c directly with injected
# semaphore functions so initialization failures are deterministic on every
# supported host platform.
check_PROGRAMS += tests/test_mqtt_props_init
tests_test_mqtt_props_init_SOURCES = \
    tests/test_mqtt_props_init.c \
    src/mqtt_client.c \
    src/mqtt_packet.c \
    src/mqtt_socket.c \
    src/mqtt_sn_client.c \
    src/mqtt_sn_packet.c
tests_test_mqtt_props_init_CPPFLAGS = -I$(top_srcdir) \
    -include $(top_srcdir)/tests/test_mqtt_props_config.h $(AM_CPPFLAGS)

# libcurl global lifecycle tests. Compile mqtt_socket.c directly so the test
# can inject deterministic curl_global_init/cleanup results.
if HAVE_LIBCURL
check_PROGRAMS += tests/test_mqtt_curl_init
tests_test_mqtt_curl_init_SOURCES = \
    tests/test_mqtt_curl_init.c \
    src/mqtt_socket.c
tests_test_mqtt_curl_init_CPPFLAGS = -I$(top_srcdir) \
    -include $(top_srcdir)/tests/test_mqtt_curl_config.h $(AM_CPPFLAGS)
endif

# Test framework headers
noinst_HEADERS += tests/unit_test.h tests/test_broker_alloc.h \
                  tests/test_client_alloc.h \
                  tests/test_mqtt_props_config.h tests/test_mqtt_curl_config.h

# MQTT-SN packet decoder tests. The SN_Decode_* routines are WOLFMQTT_LOCAL
# (hidden) so they cannot be linked from libwolfmqtt; src/mqtt_sn_packet.c is
# built directly into this binary (same approach as test_broker_connect) so the
# decoders are reachable. The test provides stubs for the LOCAL socket helpers
# the SN network paths reference but the decoder tests never exercise.
if BUILD_SN
check_PROGRAMS += tests/test_mqtt_sn
tests_test_mqtt_sn_SOURCES      = tests/test_mqtt_sn.c \
                                  src/mqtt_sn_packet.c
tests_test_mqtt_sn_CFLAGS       = -DWOLFMQTT_SN $(AM_CFLAGS)
tests_test_mqtt_sn_CPPFLAGS     = -I$(top_srcdir) $(AM_CPPFLAGS)
tests_test_mqtt_sn_LDADD        = src/libwolfmqtt.la
tests_test_mqtt_sn_DEPENDENCIES = src/libwolfmqtt.la

# MQTT-SN client state-machine tests. Compile the client sources directly so
# hidden state-machine helpers remain available to the regression tests while
# AM_CFLAGS preserves the selected library configuration.
check_PROGRAMS += tests/test_mqtt_sn_client
tests_test_mqtt_sn_client_SOURCES = \
    tests/test_mqtt_sn_client.c \
    src/mqtt_client.c \
    src/mqtt_packet.c \
    src/mqtt_socket.c \
    src/mqtt_sn_client.c \
    src/mqtt_sn_packet.c
tests_test_mqtt_sn_client_CFLAGS = -DWOLFMQTT_SN $(AM_CFLAGS)
tests_test_mqtt_sn_client_CPPFLAGS = -I$(top_srcdir) $(AM_CPPFLAGS)
tests_test_mqtt_sn_client_LDADD = $(PTHREAD_LIBS)

# Compile the client state machine directly without multithreading or
# non-blocking I/O so client-owned fallback state is covered independently of
# the options selected for libwolfmqtt.
check_PROGRAMS += tests/test_mqtt_sn_client_st_only
tests_test_mqtt_sn_client_st_only_SOURCES = \
    tests/test_mqtt_sn_client.c \
    src/mqtt_client.c \
    src/mqtt_packet.c \
    src/mqtt_socket.c \
    src/mqtt_sn_client.c \
    src/mqtt_sn_packet.c
tests_test_mqtt_sn_client_st_only_CFLAGS = -DWOLFMQTT_SN
tests_test_mqtt_sn_client_st_only_CPPFLAGS = -I$(top_srcdir) $(AM_CPPFLAGS)

# Compile the client state machine directly without WOLFMQTT_NONBLOCK so the
# multithreaded writer-contention retry path cannot be masked by the configured
# library's non-blocking support.
if BUILD_MULTITHREAD
check_PROGRAMS += tests/test_mqtt_sn_client_mt_only
tests_test_mqtt_sn_client_mt_only_SOURCES = \
    tests/test_mqtt_sn_client.c \
    src/mqtt_client.c \
    src/mqtt_packet.c \
    src/mqtt_socket.c \
    src/mqtt_sn_client.c \
    src/mqtt_sn_packet.c
tests_test_mqtt_sn_client_mt_only_CFLAGS = $(PTHREAD_CFLAGS) \
    -DWOLFMQTT_SN -DWOLFMQTT_MULTITHREAD
tests_test_mqtt_sn_client_mt_only_CPPFLAGS = -I$(top_srcdir) $(AM_CPPFLAGS)
tests_test_mqtt_sn_client_mt_only_LDADD = $(PTHREAD_LIBS)

# Exercise the non-blocking policy that releases the send lock when a write
# makes no progress. Compile the client directly so this configuration is
# covered independently of the options selected for libwolfmqtt.
check_PROGRAMS += tests/test_mqtt_sn_client_nodata
tests_test_mqtt_sn_client_nodata_SOURCES = \
    tests/test_mqtt_sn_client.c \
    src/mqtt_client.c \
    src/mqtt_packet.c \
    src/mqtt_socket.c \
    src/mqtt_sn_client.c \
    src/mqtt_sn_packet.c
tests_test_mqtt_sn_client_nodata_CFLAGS = $(PTHREAD_CFLAGS) \
    -DWOLFMQTT_SN -DWOLFMQTT_MULTITHREAD -DWOLFMQTT_NONBLOCK \
    -DWOLFMQTT_ALLOW_NODATA_UNLOCK
tests_test_mqtt_sn_client_nodata_CPPFLAGS = -I$(top_srcdir) $(AM_CPPFLAGS)
tests_test_mqtt_sn_client_nodata_LDADD = $(PTHREAD_LIBS)
endif
endif

# Broker CONNECT handler tests. Compiles src/mqtt_broker.c into the test
# binary with WOLFMQTT_BROKER_CUSTOM_NET so the network layer is replaced
# with mock callbacks driven by the harness.
if BUILD_BROKER
check_PROGRAMS += tests/test_broker_connect
tests_test_broker_connect_SOURCES = \
    tests/test_broker_connect.c \
    src/mqtt_broker.c \
    src/mqtt_broker_persist.c \
    src/mqtt_broker_persist_posix.c
tests_test_broker_connect_CFLAGS   = -DWOLFMQTT_BROKER -DWOLFMQTT_BROKER_CUSTOM_NET \
    -DWOLFMQTT_BROKER_NO_LOG -DNO_MAIN_DRIVER \
    '-DWOLFMQTT_BROKER_GET_TIME_S()=wolfmqtt_test_broker_time_s()' \
    '-DBROKER_SLEEP_MS(ms)=do{}while(0)' \
    $(AM_CFLAGS)
tests_test_broker_connect_CPPFLAGS = -I$(top_srcdir) \
    -include $(top_srcdir)/tests/test_broker_alloc.h $(AM_CPPFLAGS)
tests_test_broker_connect_LDADD    = src/libwolfmqtt.la $(LIB_STATIC_ADD)
tests_test_broker_connect_DEPENDENCIES = src/libwolfmqtt.la

check_PROGRAMS += tests/test_broker_connect_static
tests_test_broker_connect_static_SOURCES = \
    tests/test_broker_connect.c \
    src/mqtt_broker.c \
    src/mqtt_broker_persist.c \
    src/mqtt_broker_persist_posix.c
tests_test_broker_connect_static_CFLAGS = -DWOLFMQTT_BROKER \
    -DWOLFMQTT_BROKER_CUSTOM_NET -DWOLFMQTT_BROKER_NO_LOG \
    -DWOLFMQTT_STATIC_MEMORY -DNO_MAIN_DRIVER \
    '-DWOLFMQTT_BROKER_GET_TIME_S()=wolfmqtt_test_broker_time_s()' \
    '-DBROKER_SLEEP_MS(ms)=do{}while(0)' $(AM_CFLAGS)
tests_test_broker_connect_static_CPPFLAGS = -I$(top_srcdir) \
    -include $(top_srcdir)/tests/test_broker_alloc.h $(AM_CPPFLAGS)
tests_test_broker_connect_static_LDADD = src/libwolfmqtt.la $(LIB_STATIC_ADD)
tests_test_broker_connect_static_DEPENDENCIES = src/libwolfmqtt.la
endif

if BUILD_FUZZ
if BUILD_BROKER
noinst_PROGRAMS += tests/fuzz/broker_fuzz
tests_fuzz_broker_fuzz_SOURCES = \
    tests/fuzz/broker_fuzz.c \
    src/mqtt_broker.c \
    src/mqtt_broker_persist.c \
    src/mqtt_broker_persist_posix.c
tests_fuzz_broker_fuzz_CFLAGS   = -DWOLFMQTT_BROKER -DWOLFMQTT_BROKER_CUSTOM_NET \
    -DWOLFMQTT_BROKER_NO_LOG -DNO_MAIN_DRIVER \
    '-DWOLFMQTT_BROKER_GET_TIME_S()=((WOLFMQTT_BROKER_TIME_T)0)' \
    '-DBROKER_SLEEP_MS(ms)=do{}while(0)' \
    $(AM_CFLAGS)
tests_fuzz_broker_fuzz_CPPFLAGS = $(AM_CPPFLAGS)
tests_fuzz_broker_fuzz_LDFLAGS  = -fsanitize=fuzzer $(AM_LDFLAGS)
tests_fuzz_broker_fuzz_LDADD    = src/libwolfmqtt.la $(LIB_STATIC_ADD)
tests_fuzz_broker_fuzz_DEPENDENCIES = src/libwolfmqtt.la
endif
endif

EXTRA_DIST += tests/fuzz/gen_corpus.py
EXTRA_DIST += tests/fuzz/mqtt.dict
